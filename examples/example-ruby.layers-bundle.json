  "sources": {
    "invoice.rb": "# Invoice — café billing ☕ (multibyte on purpose)\nclass Invoice\n  attr_reader :items\n\n  def initialize(items)\n    @items = items\n  end\n\n  def summary\n    total = 0\n    items.each do |item|\n      total += item\n    end\n    label = \"Total\"\n    \"#{label}: #{total}\"\n  end\n\n  def overdue?\n    summary.length > 10\n  end\nend\n",
    "mailer.rb": "require_relative \"invoice\"\n\nclass Mailer\n  def notify(invoice)\n    body = invoice.summary\n    deliver(body)\n  end\n\n  def deliver(body)\n    puts body\n  end\nend\n",
    "main.rb": "require_relative \"invoice\"\nrequire_relative \"mailer\"\n\ninvoice = Invoice.new([10, 32])\nMailer.new.notify(invoice)\n"
  },
